<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jadwal Supervisi Guru KBM - SMP Negeri 7 Sentani</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .card-hover { transition: all 0.2s ease; }
    .card-hover:hover { transform: translateY(-2px); box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1); }
    .badge { @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium; }
  </style>
</head>
<body class="bg-slate-50 min-h-screen">
  <!-- HEADER -->
  <header class="bg-gradient-to-r from-indigo-700 via-blue-700 to-cyan-600 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="bg-white/20 p-3 rounded-xl">
          <i class="fas fa-clipboard-check text-2xl"></i>
        </div>
        <div>
          <h1 class="text-xl md:text-2xl font-bold tracking-tight">Jadwal Supervisi Guru KBM</h1>
          <p class="text-blue-100 text-sm">Administrasi & Pembelajaran • SMP Negeri 7 Sentani</p>
        </div>
      </div>
      <div id="userInfo" class="hidden flex items-center gap-3 bg-white/10 px-4 py-2 rounded-xl">
        <div class="text-right">
          <p id="displayName" class="font-semibold text-sm"></p>
          <p id="displayRole" class="text-xs text-blue-100"></p>
        </div>
        <button onclick="logout()" class="bg-white/20 hover:bg-white/30 p-2 rounded-lg transition">
          <i class="fas fa-sign-out-alt"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- LOGIN SCREEN -->
  <div id="loginScreen" class="max-w-md mx-auto mt-16 px-4">
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-slate-100">
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-user-check text-2xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-slate-800">Masuk Aplikasi</h2>
        <p class="text-slate-500 text-sm mt-1">Pilih peran Anda untuk melanjutkan</p>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap</label>
          <input type="text" id="inputName" placeholder="Contoh: Budi Santoso, S.Pd" 
                 class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Peran</label>
          <select id="inputRole" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none">
            <option value="guru">Guru (mengisi jadwal kesiapan)</option>
            <option value="penilai">Penilai / Supervisor</option>
            <option value="admin">Admin / Kepala Sekolah</option>
          </select>
        </div>
        <button onclick="login()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3.5 rounded-xl transition flex items-center justify-center gap-2">
          <i class="fas fa-sign-in-alt"></i> Masuk
        </button>
      </div>
      <p class="text-xs text-center text-slate-400 mt-6">Data tersimpan lokal di perangkat ini. Bagikan link aplikasi ke rekan guru.</p>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="mainApp" class="hidden max-w-7xl mx-auto px-4 py-8">
    <!-- NAV TABS -->
    <div class="flex flex-wrap gap-2 mb-8 bg-white p-2 rounded-2xl shadow-sm border border-slate-100">
      <button onclick="showTab('dashboard')" id="tab-dashboard" class="tab-btn px-5 py-2.5 rounded-xl font-medium text-sm transition bg-indigo-600 text-white">
        <i class="fas fa-chart-pie mr-2"></i>Dashboard
      </button>
      <button onclick="showTab('isi')" id="tab-isi" class="tab-btn px-5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 hover:bg-slate-100">
        <i class="fas fa-edit mr-2"></i>Isi Jadwal
      </button>
      <button onclick="showTab('daftar')" id="tab-daftar" class="tab-btn px-5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 hover:bg-slate-100">
        <i class="fas fa-list mr-2"></i>Daftar Supervisi
      </button>
      <button onclick="showTab('pemetaan')" id="tab-pemetaan" class="tab-btn px-5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 hover:bg-slate-100">
        <i class="fas fa-calendar-alt mr-2"></i>Pemetaan
      </button>
    </div>

    <!-- TAB: DASHBOARD -->
    <div id="view-dashboard" class="tab-view">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-500 text-sm">Total Jadwal</p>
              <p id="statTotal" class="text-3xl font-bold text-slate-800 mt-1">0</p>
            </div>
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center">
              <i class="fas fa-clipboard-list text-xl"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-500 text-sm">Menunggu Penilai</p>
              <p id="statPending" class="text-3xl font-bold text-amber-600 mt-1">0</p>
            </div>
            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center">
              <i class="fas fa-hourglass-half text-xl"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-500 text-sm">Sudah Dinilai</p>
              <p id="statDone" class="text-3xl font-bold text-emerald-600 mt-1">0</p>
            </div>
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center">
              <i class="fas fa-check-circle text-xl"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-500 text-sm">Guru Terdaftar</p>
              <p id="statGuru" class="text-3xl font-bold text-blue-600 mt-1">0</p>
            </div>
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center">
              <i class="fas fa-chalkboard-teacher text-xl"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
        <h3 class="font-bold text-lg text-slate-800 mb-4 flex items-center gap-2">
          <i class="fas fa-bolt text-amber-500"></i> Aktivitas Terbaru
        </h3>
        <div id="recentActivity" class="space-y-3">
          <p class="text-slate-400 text-sm">Belum ada data.</p>
        </div>
      </div>
    </div>

    <!-- TAB: ISI JADWAL (GURU) -->
    <div id="view-isi" class="tab-view hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
        <h2 class="text-xl font-bold text-slate-800 mb-1">Form Kesiapan Supervisi KBM</h2>
        <p class="text-slate-500 text-sm mb-6">Isi jadwal kesiapan Anda untuk disupervisi (Administrasi & Pembelajaran)</p>

        <form id="formJadwal" onsubmit="simpanJadwal(event)" class="space-y-5">
          <input type="hidden" id="editId" value="" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Hari Kesiapan *</label>
              <select id="hari" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none">
                <option value="">-- Pilih Hari --</option>
                <option>Senin</option>
                <option>Selasa</option>
                <option>Rabu</option>
                <option>Kamis</option>
                <option>Jumat</option>
                <option>Sabtu</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Jam Pelajaran *</label>
              <select id="jam" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none">
                <option value="">-- Pilih Jam --</option>
                <option>Jam ke-1 (07.00-07.40)</option>
                <option>Jam ke-2 (07.40-08.20)</option>
                <option>Jam ke-3 (08.20-09.00)</option>
                <option>Jam ke-4 (09.15-09.55)</option>
                <option>Jam ke-5 (09.55-10.35)</option>
                <option>Jam ke-6 (10.35-11.15)</option>
                <option>Jam ke-7 (11.15-11.55)</option>
                <option>Jam ke-8 (12.30-13.10)</option>
                <option>Jam ke-9 (13.10-13.50)</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Kelas *</label>
              <select id="kelas" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none">
                <option value="">-- Pilih Kelas --</option>
                <option>VII-A</option><option>VII-B</option><option>VII-C</option><option>VII-D</option>
                <option>VIII-A</option><option>VIII-B</option><option>VIII-C</option><option>VIII-D</option>
                <option>IX-A</option><option>IX-B</option><option>IX-C</option><option>IX-D</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Mata Pelajaran / Materi *</label>
              <input type="text" id="materi" required placeholder="Contoh: Matematika - Persamaan Linear" 
                     class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Jenis Supervisi *</label>
            <div class="flex flex-wrap gap-3">
              <label class="flex items-center gap-2 bg-slate-50 px-4 py-2.5 rounded-xl border cursor-pointer hover:bg-indigo-50">
                <input type="checkbox" name="jenis" value="Administrasi" class="rounded text-indigo-600" /> Administrasi
              </label>
              <label class="flex items-center gap-2 bg-slate-50 px-4 py-2.5 rounded-xl border cursor-pointer hover:bg-indigo-50">
                <input type="checkbox" name="jenis" value="Pembelajaran" class="rounded text-indigo-600" checked /> Pembelajaran
              </label>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Sasaran KBM yang akan diamati *</label>
            <p class="text-xs text-slate-400 mb-2">Centang aspek yang siap disupervisi / ingin difokuskan</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="sasaranContainer">
              <!-- diisi JS -->
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Catatan / Kesiapan Tambahan (opsional)</label>
            <textarea id="catatanGuru" rows="3" placeholder="Contoh: RPP sudah lengkap, media pembelajaran siap, dll."
                      class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
          </div>

          <div class="flex gap-3 pt-2">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition flex items-center gap-2">
              <i class="fas fa-save"></i> <span id="btnSubmitText">Simpan Jadwal</span>
            </button>
            <button type="button" onclick="resetForm()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-5 py-3 rounded-xl transition">
              Reset
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- TAB: DAFTAR SUPERVISI -->
    <div id="view-daftar" class="tab-view hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <h2 class="text-xl font-bold text-slate-800">Daftar Jadwal Supervisi</h2>
        <div class="flex gap-2">
          <select id="filterStatus" onchange="renderDaftar()" class="px-3 py-2 rounded-xl border border-slate-200 text-sm outline-none">
            <option value="all">Semua Status</option>
            <option value="menunggu">Menunggu Penilai</option>
            <option value="ditugaskan">Sudah Ditugaskan</option>
            <option value="selesai">Selesai Dinilai</option>
          </select>
          <input type="text" id="searchGuru" oninput="renderDaftar()" placeholder="Cari nama guru..." 
                 class="px-3 py-2 rounded-xl border border-slate-200 text-sm outline-none w-48" />
        </div>
      </div>

      <div id="daftarContainer" class="space-y-4">
        <!-- cards diisi JS -->
      </div>
    </div>

    <!-- TAB: PEMETAAN -->
    <div id="view-pemetaan" class="tab-view hidden">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
        <h2 class="text-xl font-bold text-slate-800 mb-4">Pemetaan Jadwal Supervisi per Hari</h2>
        <div id="pemetaanGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- diisi JS -->
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
        <h3 class="font-bold text-lg mb-4">Ringkasan per Penilai</h3>
        <div id="ringkasanPenilai" class="overflow-x-auto">
          <!-- table -->
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL DETAIL + FEEDBACK -->
  <div id="modalDetail" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between rounded-t-2xl">
        <h3 class="font-bold text-lg text-slate-800">Detail Supervisi & Umpan Balik</h3>
        <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
      </div>
      <div id="modalBody" class="p-6 space-y-5">
        <!-- diisi JS -->
      </div>
    </div>
  </div>

  <!-- TOAST -->
  <div id="toast" class="fixed bottom-6 right-6 bg-slate-800 text-white px-5 py-3 rounded-xl shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center gap-2">
    <i class="fas fa-check-circle text-emerald-400"></i>
    <span id="toastMsg">Berhasil</span>
  </div>

  <script>
    // ===================== DATA & STATE =====================
    const SASARAN_LIST = [
      "Kelengkapan Administrasi Guru (RPP, Silabus, Prota, Promes)",
      "Kesesuaian RPP dengan pelaksanaan pembelajaran",
      "Pembukaan pelajaran (apersepsi & motivasi)",
      "Penguasaan materi pelajaran",
      "Strategi/metode pembelajaran yang digunakan",
      "Penggunaan media & sumber belajar",
      "Keterlibatan & partisipasi siswa",
      "Pengelolaan kelas & waktu",
      "Penilaian proses & hasil belajar",
      "Penutupan pelajaran (refleksi & tindak lanjut)",
      "Sikap & keteladanan guru",
      "Pemanfaatan TIK dalam pembelajaran"
    ];

    let currentUser = null;
    let jadwalList = JSON.parse(localStorage.getItem('supervisi_smp7') || '[]');

    // ===================== INIT =====================
    function initSasaran() {
      const container = document.getElementById('sasaranContainer');
      container.innerHTML = SASARAN_LIST.map((s, i) => `
        <label class="flex items-start gap-2 bg-slate-50 p-3 rounded-xl border border-slate-100 cursor-pointer hover:bg-indigo-50 hover:border-indigo-200 transition">
          <input type="checkbox" name="sasaran" value="${s}" class="mt-1 rounded text-indigo-600" />
          <span class="text-sm text-slate-700">${s}</span>
        </label>
      `).join('');
    }

    // ===================== AUTH =====================
    function login() {
      const name = document.getElementById('inputName').value.trim();
      const role = document.getElementById('inputRole').value;
      if (!name) return showToast('Nama wajib diisi', true);

      currentUser = { name, role };
      localStorage.setItem('supervisi_user', JSON.stringify(currentUser));

      document.getElementById('loginScreen').classList.add('hidden');
      document.getElementById('mainApp').classList.remove('hidden');
      document.getElementById('userInfo').classList.remove('hidden');
      document.getElementById('displayName').textContent = name;
      document.getElementById('displayRole').textContent = role === 'guru' ? 'Guru' : role === 'penilai' ? 'Penilai' : 'Admin';

      // Sembunyikan tab isi jika penilai murni (opsional, biarkan semua bisa isi)
      updateStats();
      renderDaftar();
      renderPemetaan();
      showTab('dashboard');
    }

    function logout() {
      currentUser = null;
      localStorage.removeItem('supervisi_user');
      document.getElementById('loginScreen').classList.remove('hidden');
      document.getElementById('mainApp').classList.add('hidden');
      document.getElementById('userInfo').classList.add('hidden');
      document.getElementById('inputName').value = '';
    }

    // Cek session
    window.onload = () => {
      initSasaran();
      const saved = localStorage.getItem('supervisi_user');
      if (saved) {
        currentUser = JSON.parse(saved);
        document.getElementById('inputName').value = currentUser.name;
        document.getElementById('inputRole').value = currentUser.role;
        login();
      }
    };

    // ===================== TABS =====================
    function showTab(tab) {
      document.querySelectorAll('.tab-view').forEach(v => v.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white');
        b.classList.add('text-slate-600', 'hover:bg-slate-100');
      });
      document.getElementById('view-' + tab).classList.remove('hidden');
      const btn = document.getElementById('tab-' + tab);
      btn.classList.add('bg-indigo-600', 'text-white');
      btn.classList.remove('text-slate-600', 'hover:bg-slate-100');

      if (tab === 'daftar') renderDaftar();
      if (tab === 'pemetaan') renderPemetaan();
      if (tab === 'dashboard') updateStats();
    }

    // ===================== CRUD JADWAL =====================
    function simpanJadwal(e) {
      e.preventDefault();
      const hari = document.getElementById('hari').value;
      const jam = document.getElementById('jam').value;
      const kelas = document.getElementById('kelas').value;
      const materi = document.getElementById('materi').value;
      const catatanGuru = document.getElementById('catatanGuru').value;
      const jenis = [...document.querySelectorAll('input[name="jenis"]:checked')].map(c => c.value);
      const sasaran = [...document.querySelectorAll('input[name="sasaran"]:checked')].map(c => c.value);
      const editId = document.getElementById('editId').value;

      if (jenis.length === 0) return showToast('Pilih minimal 1 jenis supervisi', true);
      if (sasaran.length === 0) return showToast('Pilih minimal 1 sasaran KBM', true);

      if (editId) {
        const idx = jadwalList.findIndex(j => j.id === editId);
        if (idx > -1) {
          jadwalList[idx] = {
            ...jadwalList[idx],
            hari, jam, kelas, materi, jenis, sasaran, catatanGuru,
            updatedAt: new Date().toISOString()
          };
        }
        showToast('Jadwal berhasil diperbarui');
      } else {
        const newItem = {
          id: 'SUP-' + Date.now(),
          guru: currentUser.name,
          hari, jam, kelas, materi, jenis, sasaran, catatanGuru,
          penilai: null,
          status: 'menunggu', // menunggu | ditugaskan | selesai
          feedback: '',
          skor: null,
          catatanPenilai: '',
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString()
        };
        jadwalList.unshift(newItem);
        showToast('Jadwal berhasil disimpan');
      }

      saveData();
      resetForm();
      updateStats();
      showTab('daftar');
    }

    function resetForm() {
      document.getElementById('formJadwal').reset();
      document.getElementById('editId').value = '';
      document.getElementById('btnSubmitText').textContent = 'Simpan Jadwal';
      document.querySelectorAll('input[name="sasaran"]').forEach(c => c.checked = false);
      document.querySelector('input[name="jenis"][value="Pembelajaran"]').checked = true;
    }

    function editJadwal(id) {
      const item = jadwalList.find(j => j.id === id);
      if (!item) return;
      if (item.guru !== currentUser.name && currentUser.role === 'guru') {
        return showToast('Anda hanya bisa edit jadwal sendiri', true);
      }

      document.getElementById('editId').value = item.id;
      document.getElementById('hari').value = item.hari;
      document.getElementById('jam').value = item.jam;
      document.getElementById('kelas').value = item.kelas;
      document.getElementById('materi').value = item.materi;
      document.getElementById('catatanGuru').value = item.catatanGuru || '';
      document.getElementById('btnSubmitText').textContent = 'Update Jadwal';

      document.querySelectorAll('input[name="jenis"]').forEach(c => {
        c.checked = item.jenis.includes(c.value);
      });
      document.querySelectorAll('input[name="sasaran"]').forEach(c => {
        c.checked = item.sasaran.includes(c.value);
      });

      showTab('isi');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hapusJadwal(id) {
      if (!confirm('Yakin hapus jadwal ini?')) return;
      jadwalList = jadwalList.filter(j => j.id !== id);
      saveData();
      renderDaftar();
      updateStats();
      showToast('Jadwal dihapus');
    }

    // ===================== ASSIGN PENILAI =====================
    function assignPenilai(id, namaPenilai = null) {
      const item = jadwalList.find(j => j.id === id);
      if (!item) return;

      const penilai = namaPenilai || currentUser.name;
      item.penilai = penilai;
      item.status = 'ditugaskan';
      item.updatedAt = new Date().toISOString();
      saveData();
      renderDaftar();
      updateStats();
      showToast(`Penilai "${penilai}" ditugaskan`);
      closeModal();
    }

    function bukaAssign(id) {
      const nama = prompt('Masukkan nama Penilai yang ditunjuk:', currentUser.name);
      if (nama && nama.trim()) assignPenilai(id, nama.trim());
    }

    // ===================== FEEDBACK =====================
    function simpanFeedback(id) {
      const feedback = document.getElementById('inputFeedback').value.trim();
      const catatan = document.getElementById('inputCatatanPenilai').value.trim();
      const skor = document.getElementById('inputSkor').value;

      const item = jadwalList.find(j => j.id === id);
      if (!item) return;

      item.feedback = feedback;
      item.catatanPenilai = catatan;
      item.skor = skor ? Number(skor) : null;
      item.status = 'selesai';
      item.penilai = item.penilai || currentUser.name;
      item.updatedAt = new Date().toISOString();

      saveData();
      closeModal();
      renderDaftar();
      updateStats();
      showToast('Umpan balik berhasil disimpan');
    }

    // ===================== RENDER =====================
    function renderDaftar() {
      const filter = document.getElementById('filterStatus').value;
      const search = document.getElementById('searchGuru').value.toLowerCase();
      let data = [...jadwalList];

      if (filter !== 'all') data = data.filter(j => j.status === filter);
      if (search) data = data.filter(j => j.guru.toLowerCase().includes(search));

      const container = document.getElementById('daftarContainer');
      if (data.length === 0) {
        container.innerHTML = `<div class="text-center py-16 text-slate-400">
          <i class="fas fa-inbox text-5xl mb-4"></i>
          <p>Belum ada jadwal supervisi</p>
        </div>`;
        return;
      }

      container.innerHTML = data.map(item => {
        const statusBadge = {
          menunggu: 'bg-amber-100 text-amber-800',
          ditugaskan: 'bg-blue-100 text-blue-800',
          selesai: 'bg-emerald-100 text-emerald-800'
        }[item.status];
        const statusText = {
          menunggu: 'Menunggu Penilai',
          ditugaskan: 'Sudah Ditugaskan',
          selesai: 'Selesai Dinilai'
        }[item.status];

        const isOwner = item.guru === currentUser?.name;
        const canAssess = currentUser?.role === 'penilai' || currentUser?.role === 'admin';

        return `
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 card-hover">
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <h3 class="font-bold text-slate-800 text-lg">${item.guru}</h3>
                <span class="badge ${statusBadge}">${statusText}</span>
                ${item.jenis.map(j => `<span class="badge bg-indigo-50 text-indigo-700">${j}</span>`).join('')}
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-y-1 gap-x-4 text-sm text-slate-600 mt-3">
                <div><i class="fas fa-calendar-day text-indigo-500 w-5"></i> ${item.hari}</div>
                <div><i class="fas fa-clock text-indigo-500 w-5"></i> ${item.jam}</div>
                <div><i class="fas fa-school text-indigo-500 w-5"></i> ${item.kelas}</div>
                <div><i class="fas fa-book text-indigo-500 w-5"></i> ${item.materi}</div>
              </div>
              ${item.penilai ? `<p class="text-sm mt-2 text-slate-500"><i class="fas fa-user-tie mr-1"></i> Penilai: <strong>${item.penilai}</strong></p>` : ''}
              ${item.skor !== null ? `<p class="text-sm mt-1"><span class="font-medium text-emerald-600">Skor: ${item.skor}/100</span></p>` : ''}
            </div>
            <div class="flex flex-wrap gap-2">
              <button onclick="bukaDetail('${item.id}')" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-sm font-medium transition">
                <i class="fas fa-eye mr-1"></i> Detail
              </button>
              ${isOwner || currentUser?.role === 'admin' ? `
                <button onclick="editJadwal('${item.id}')" class="px-3 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-xl text-sm font-medium transition">
                  <i class="fas fa-edit mr-1"></i>
                </button>
                <button onclick="hapusJadwal('${item.id}')" class="px-3 py-2 bg-red-50 text-red-600 hover:bg-red-100 rounded-xl text-sm font-medium transition">
                  <i class="fas fa-trash mr-1"></i>
                </button>
              ` : ''}
              ${canAssess && item.status !== 'selesai' ? `
                <button onclick="bukaAssign('${item.id}')" class="px-3 py-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-xl text-sm font-medium transition">
                  <i class="fas fa-user-plus mr-1"></i> Tunjuk Penilai
                </button>
              ` : ''}
            </div>
          </div>
        </div>`;
      }).join('');
    }

    function bukaDetail(id) {
      const item = jadwalList.find(j => j.id === id);
      if (!item) return;

      const canGiveFeedback = (currentUser.role === 'penilai' || currentUser.role === 'admin') && item.status !== 'selesai';

      document.getElementById('modalBody').innerHTML = `
        <div class="space-y-1 text-sm">
          <p><span class="text-slate-500 w-32 inline-block">ID</span> <strong>${item.id}</strong></p>
          <p><span class="text-slate-500 w-32 inline-block">Guru</span> <strong>${item.guru}</strong></p>
          <p><span class="text-slate-500 w-32 inline-block">Hari / Jam</span> ${item.hari}, ${item.jam}</p>
          <p><span class="text-slate-500 w-32 inline-block">Kelas</span> ${item.kelas}</p>
          <p><span class="text-slate-500 w-32 inline-block">Materi</span> ${item.materi}</p>
          <p><span class="text-slate-500 w-32 inline-block">Jenis</span> ${item.jenis.join(', ')}</p>
          <p><span class="text-slate-500 w-32 inline-block">Penilai</span> ${item.penilai || '<em class="text-amber-600">Belum ditunjuk</em>'}</p>
          <p><span class="text-slate-500 w-32 inline-block">Status</span> ${item.status}</p>
        </div>

        <div>
          <h4 class="font-semibold text-slate-800 mb-2">Sasaran KBM yang diamati:</h4>
          <ul class="list-disc list-inside text-sm text-slate-600 space-y-1 bg-slate-50 p-4 rounded-xl">
            ${item.sasaran.map(s => `<li>${s}</li>`).join('')}
          </ul>
        </div>

        ${item.catatanGuru ? `
        <div>
          <h4 class="font-semibold text-slate-800 mb-1">Catatan Guru:</h4>
          <p class="text-sm text-slate-600 bg-slate-50 p-3 rounded-xl">${item.catatanGuru}</p>
        </div>` : ''}

        ${item.status === 'selesai' ? `
        <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-4">
          <h4 class="font-semibold text-emerald-800 mb-2"><i class="fas fa-comment-dots mr-2"></i>Umpan Balik Penilai</h4>
          <p class="text-sm mb-2"><strong>Skor:</strong> ${item.skor ?? '-'} / 100</p>
          <p class="text-sm mb-2"><strong>Feedback:</strong><br>${item.feedback || '-'}</p>
          <p class="text-sm"><strong>Catatan tambahan:</strong><br>${item.catatanPenilai || '-'}</p>
          <p class="text-xs text-emerald-600 mt-2">Dinilai oleh: ${item.penilai}</p>
        </div>
        ` : ''}

        ${canGiveFeedback ? `
        <div class="border-t pt-5 space-y-4">
          <h4 class="font-semibold text-slate-800">Berikan Umpan Balik / Tanggapan</h4>
          <div>
            <label class="text-sm font-medium">Skor (0-100)</label>
            <input type="number" id="inputSkor" min="0" max="100" value="80" class="w-full mt-1 px-4 py-2.5 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="text-sm font-medium">Umpan Balik Utama *</label>
            <textarea id="inputFeedback" rows="3" required placeholder="Kekuatan, area perbaikan, saran..."
              class="w-full mt-1 px-4 py-2.5 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
          </div>
          <div>
            <label class="text-sm font-medium">Catatan Tambahan</label>
            <textarea id="inputCatatanPenilai" rows="2" placeholder="Catatan lain..."
              class="w-full mt-1 px-4 py-2.5 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
          </div>
          <div class="flex gap-2">
            <button onclick="simpanFeedback('${item.id}')" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-2.5 rounded-xl transition">
              <i class="fas fa-paper-plane mr-2"></i>Simpan Umpan Balik
            </button>
            ${!item.penilai ? `
            <button onclick="assignPenilai('${item.id}')" class="bg-indigo-100 text-indigo-700 hover:bg-indigo-200 font-medium px-4 py-2.5 rounded-xl transition">
              Jadikan Saya Penilai
            </button>` : ''}
          </div>
        </div>
        ` : ''}

        ${currentUser.role !== 'guru' && item.status === 'menunggu' ? `
        <button onclick="bukaAssign('${item.id}')" class="w-full mt-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition">
          <i class="fas fa-user-plus mr-2"></i>Tunjuk / Assign Penilai
        </button>
        ` : ''}
      `;

      document.getElementById('modalDetail').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('modalDetail').classList.add('hidden');
    }

    // ===================== PEMETAAN =====================
    function renderPemetaan() {
      const hariList = ['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
      const grid = document.getElementById('pemetaanGrid');

      grid.innerHTML = hariList.map(hari => {
        const items = jadwalList.filter(j => j.hari === hari);
        return `
        <div class="border border-slate-200 rounded-2xl overflow-hidden">
          <div class="bg-indigo-600 text-white px-4 py-3 font-semibold flex justify-between">
            <span>${hari}</span>
            <span class="bg-white/20 text-xs px-2 py-0.5 rounded-full">${items.length}</span>
          </div>
          <div class="p-3 space-y-2 max-h-64 overflow-y-auto">
            ${items.length === 0 ? '<p class="text-slate-400 text-sm text-center py-4">Kosong</p>' :
              items.map(i => `
                <div class="bg-slate-50 rounded-xl p-3 text-sm cursor-pointer hover:bg-indigo-50" onclick="bukaDetail('${i.id}')">
                  <p class="font-medium text-slate-800">${i.guru}</p>
                  <p class="text-xs text-slate-500">${i.jam} • ${i.kelas}</p>
                  <p class="text-xs text-indigo-600 mt-1">${i.materi}</p>
                  <span class="badge mt-1 ${i.status==='selesai'?'bg-emerald-100 text-emerald-700':i.status==='ditugaskan'?'bg-blue-100 text-blue-700':'bg-amber-100 text-amber-700'} text-[10px]">
                    ${i.status}
                  </span>
                </div>
              `).join('')}
          </div>
        </div>`;
      }).join('');

      // Ringkasan penilai
      const penilaiMap = {};
      jadwalList.forEach(j => {
        const p = j.penilai || 'Belum ditugaskan';
        if (!penilaiMap[p]) penilaiMap[p] = { total: 0, selesai: 0 };
        penilaiMap[p].total++;
        if (j.status === 'selesai') penilaiMap[p].selesai++;
      });

      document.getElementById('ringkasanPenilai').innerHTML = `
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 text-left">
              <th class="px-4 py-3 rounded-l-xl">Penilai</th>
              <th class="px-4 py-3">Total Ditugaskan</th>
              <th class="px-4 py-3">Selesai</th>
              <th class="px-4 py-3 rounded-r-xl">Progress</th>
            </tr>
          </thead>
          <tbody>
            ${Object.entries(penilaiMap).map(([nama, v]) => `
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3 font-medium">${nama}</td>
                <td class="px-4 py-3">${v.total}</td>
                <td class="px-4 py-3">${v.selesai}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 bg-slate-100 rounded-full h-2">
                      <div class="bg-emerald-500 h-2 rounded-full" style="width:${v.total? (v.selesai/v.total*100):0}%"></div>
                    </div>
                    <span class="text-xs text-slate-500">${v.total? Math.round(v.selesai/v.total*100):0}%</span>
                  </div>
                </td>
              </tr>
            `).join('') || '<tr><td colspan="4" class="px-4 py-8 text-center text-slate-400">Belum ada data</td></tr>'}
          </tbody>
        </table>`;
    }

    // ===================== STATS =====================
    function updateStats() {
      document.getElementById('statTotal').textContent = jadwalList.length;
      document.getElementById('statPending').textContent = jadwalList.filter(j => j.status === 'menunggu').length;
      document.getElementById('statDone').textContent = jadwalList.filter(j => j.status === 'selesai').length;
      const gurus = [...new Set(jadwalList.map(j => j.guru))];
      document.getElementById('statGuru').textContent = gurus.length;

      // recent
      const recent = jadwalList.slice(0, 5);
      document.getElementById('recentActivity').innerHTML = recent.length ? recent.map(j => `
        <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl">
          <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm">
            ${j.guru.charAt(0)}
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium text-slate-800 truncate">${j.guru} — ${j.kelas}</p>
            <p class="text-xs text-slate-500">${j.hari} • ${j.materi}</p>
          </div>
          <span class="badge ${j.status==='selesai'?'bg-emerald-100 text-emerald-700':j.status==='ditugaskan'?'bg-blue-100 text-blue-700':'bg-amber-100 text-amber-700'}">
            ${j.status}
          </span>
        </div>
      `).join('') : '<p class="text-slate-400 text-sm">Belum ada aktivitas.</p>';
    }

    // ===================== UTIL =====================
    function saveData() {
      localStorage.setItem('supervisi_smp7', JSON.stringify(jadwalList));
    }

    function showToast(msg, isError = false) {
      const t = document.getElementById('toast');
      document.getElementById('toastMsg').textContent = msg;
      t.querySelector('i').className = isError ? 'fas fa-exclamation-circle text-red-400' : 'fas fa-check-circle text-emerald-400';
      t.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => t.classList.add('translate-y-20', 'opacity-0'), 2800);
    }

    // Close modal on outside click
    document.getElementById('modalDetail').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });
  </script>
</body>
</html>